[Unit]
Description=Email Client (Flask Web UI)
After=network.target
Requires=mail-server.service

[Service]
Type=simple
WorkingDirectory=/home/mal/git/py_pg_client
Environment=FLASK_APP=run.py
Environment=FLASK_ENV=production
Environment=PYTHONPATH=/home/mal/git/py_pg_client

ExecStart=/home/mal/git/py_pg_client/venv/bin/python /home/mal/git/py_pg_client/run.py

Restart=always
RestartSec=10

StandardOutput=journal
StandardError=journal
SyslogIdentifier=email-client

[Install]
WantedBy=default.target
